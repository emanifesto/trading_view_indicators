            [bull_fvg_m, bull_fvg_c] = update_bullish_fvgs(bull_fvgs_4, htf_close, htf_low)
            bull_fvg_mitigated := bull_fvg_m
            bull_fvg_closed := bull_fvg_c
        else
            bull_fvg_mitigated := false
            bull_fvg_closed := false

        if bear_fvgs_4.size() > 0
            [bear_fvg_m, bear_fvg_c] = update_bearish_fvgs(bear_fvgs_4, htf_close, htf_high)
            bear_fvg_mitigated := bear_fvg_m
            bear_fvg_closed := bear_fvg_c
        else
            bear_fvg_mitigated := false
            bear_fvg_closed := false
            
        new_fvg_mitigated := bull_fvg_mitigated or bear_fvg_mitigated
        new_fvg_closed := bull_fvg_closed or bear_fvg_closed

// Order Block
if display_OBs
    if not na(incorrect_tf(htf1, htf2, htf3, htf4, display_htf1, display_htf2, display_htf3, display_htf4))
        runtime.error("""While OB Multi Timeframe Display Toggle is enabled in settings, the timeframe of the chart must not be greater than any 
        higher timeframes chosen.""")

    array<string> selected_tfs = array.new<string>()
    
    if display_htf1 and na(duplicate_tf(htf1, selected_tfs))
        selected_tfs.unshift(htf1)
        var array<ob> bull_obs_1 = array.new<ob>()
