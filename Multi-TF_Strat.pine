//     if bear_fvgs.size() > 0
//         [bear_fvg_m, bear_fvg_c] = update_bearish_fvgs(bear_fvgs, htf_close, htf_high)

detect_ob() =>
    ob OB = na
    bool bull_ob_o = false
    bool bear_ob_o = false
    
    float trigger = ta.change(ta.rsi(close[1], 14), 1)
    float bull_pivot = ta.lowest(low[1], 2)
    float bear_pivot = ta.highest(high[1], 2)

    if bull_pivot == ta.lowest(low[1], ob_pivot_length) and trigger >= ob_rsi_threshold
        chart.point y = chart.point.from_time(time - timeframe.in_seconds() * 1000, bull_pivot)
        chart.point x = na
        if ob_size == "Full"
            x := low[1] < low[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, hl2[1]) : chart.point.from_time(time - timeframe.in_seconds() * 2000 , hl2[2])
        else if ob_size == "Medium"
            x := low[1] < low[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, ((2 * low[1]) + high[1]) / 3) : chart.point.from_time(time - timeframe.in_seconds() * 2000, ((2 * low[2]) + high[2]) / 3)
        else
            x := low[1] < low[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, (hl2[1] + low[1]) / 2) : chart.point.from_time(time - timeframe.in_seconds() * 2000, (hl2[2] + low[2]) / 2)
        
        string id = str.format("{0}-{1}", x.price, y.price)
        OB := ob.new(id, x, y, sentiment.BULL, status.OPEN)
        bull_ob_o := true

    if bear_pivot == ta.highest(high[1], ob_pivot_length) and trigger <= -ob_rsi_threshold
        chart.point x = chart.point.from_time(time - timeframe.in_seconds() * 1000, bear_pivot)
        chart.point y = na

        if ob_size == "Full"
            y := high[1] > high[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, hl2[1]) : chart.point.from_time(time - timeframe.in_seconds() * 2000, hl2[2])
        else if ob_size == "Medium"
            y := high[1] > high[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, ((2 * high[1]) + low[1]) / 3) : chart.point.from_time(time - timeframe.in_seconds() * 2000, ((2 * high[2]) + low[2]) / 3)
        else
            y := high[1] > high[2] ? chart.point.from_time(time - timeframe.in_seconds() * 1000, (hl2[1] + high[1]) / 2) : chart.point.from_time(time - timeframe.in_seconds() * 2000, (hl2[2] + high[2]) / 2)
        
        string id = str.format("{0}-{1}", x.price, y.price)
        OB := ob.new(id, x, y, sentiment.BEAR, status.OPEN)
        bear_ob_o := true
    
    [OB, bull_ob_o, bear_ob_o, close, high, low]

plot_ob(ob OB, array<ob> bull_arr, array<ob> bear_arr) =>
    if OB.direction == sentiment.BULL  and (bull_arr.size() == 0 or (bull_arr.size() != 0 and OB.id != bull_arr.get(0).id))
        OB.display := box.new(OB.top, OB.bottom, extend=extend.right, bgcolor=ob_bull_box_color, xloc = xloc.bar_time, border_color=ob_bull_border_color)
        bull_arr.unshift(OB)
    else if OB.direction == sentiment.BEAR  and (bear_arr.size() == 0 or (bear_arr.size() != 0 and OB.id != bear_arr.get(0).id))
        OB.display := box.new(OB.top, OB.bottom, extend=extend.right, bgcolor=ob_bear_box_color, xloc = xloc.bar_time, border_color=ob_bear_border_color)
        bear_arr.unshift(OB)
    
update_bullish_obs(array<ob> bull_arr, float htf_close = close, float htf_low = low) =>
    array<int> closed_idxs = array.new<int>()
    bool bull_ob_m = false
    bool bull_ob_c = false

    for [idx, OB] in bull_arr
        float top = OB.top.price
        float bottom = OB.bottom.price
        if htf_close[1] < bottom
            bull_ob_c := true
            box.delete(OB.display)
            array.unshift(closed_idxs, idx)
            continue
        if htf_close > top and OB.state != status.MITIGATED
            break
        if htf_close > top and OB.state == status.MITIGATED
            OB.state := status.OPEN
            box bx = OB.display
            bx.set_bgcolor(ob_bull_box_color)
            bx.set_border_width(0)
            continue
        if htf_low < top and OB.state == status.OPEN
            bull_ob_m := true
            OB.state := status.MITIGATED
            box bx = OB.display
            bx.set_bgcolor(ob_bull_mitigated_color)
            bx.set_border_width(3)
        
    garbage_collect(closed_idxs, bull_arr)
    [bull_ob_m, bull_ob_c]

update_bearish_obs(array<ob> bear_arr, float htf_close = close, float htf_high = high) =>
    array<int> closed_idxs = array.new<int>()
    bool bear_ob_m = false
    bool bear_ob_c = false

    for [idx, OB] in bear_arr
        float top = OB.top.price
        float bottom = OB.bottom.price
        if htf_close[1] > top
            bear_ob_c := true
            box.delete(OB.display)
            array.unshift(closed_idxs, idx)
            continue
        if htf_close < bottom and OB.state != status.MITIGATED
            break
        if htf_close < bottom and OB.state == status.MITIGATED
            OB.state := status.OPEN
            box bx = OB.display
            bx.set_bgcolor(ob_bear_box_color)
            bx.set_border_width(0)
            continue
        if htf_high > bottom and OB.state == status.OPEN
            bear_ob_m := true
            OB.state := status.MITIGATED
            box bx = OB.display
            bx.set_bgcolor(ob_bear_mitigated_color)
            bx.set_border_width(3)
        
    garbage_collect(closed_idxs, bear_arr)
    [bear_ob_m, bear_ob_c]



// RUNTIME
// Line of logic that is run for every bar execution


// Booleans
var bool new_fvg_opened = false
var bool new_fvg_mitigated = false
var bool new_fvg_closed = false
var bool new_ob_opened = false
var bool new_ob_mitigated = false
var bool new_ob_closed = false

var bool bull_fvg_opened = false
var bool bull_fvg_mitigated = false
var bool bull_fvg_closed = false
var bool bear_fvg_opened = false
var bool bear_fvg_mitigated = false
var bool bear_fvg_closed = false
var bool bull_ob_opened = false
var bool bull_ob_mitigated = false
var bool bull_ob_closed = false
var bool bear_ob_opened = false
var bool bear_ob_mitigated = false
var bool bear_ob_closed = false


// Fair Value Gaps
if display_fvgs
    if not na(incorrect_tf(htf1, htf2, htf3, htf4, display_htf1, display_htf2, display_htf3, display_htf4))
        runtime.error("""While FVG Multi Timeframe Display Toggle is enabled in settings, the timeframe of the chart must not be greater than any 
        higher timeframes chosen.""")

    array<string> selected_tfs = array.new<string>()
    
    if display_htf1 and na(duplicate_tf(htf1, selected_tfs))
        selected_tfs.unshift(htf1)

        // if na(htf1) or htf1 == timeframe.main_period
        //     load_chart_fvgs()
        // else
        var array<fvg> bull_fvgs_1 = array.new<fvg>()
        var array<fvg> bear_fvgs_1 = array.new<fvg>()
        [FVG, bull_fvg_o, bear_fvg_o, htf_close, htf_high, htf_low] = request.security(syminfo.tickerid, htf1, detect_fvg())

        bull_fvg_opened := bull_fvg_o
        bear_fvg_opened := bear_fvg_o
        new_fvg_opened := bull_fvg_opened or bear_fvg_opened
        new_fvg_mitigated := bull_fvg_mitigated or bear_fvg_mitigated
        new_fvg_closed := bull_fvg_closed or bear_fvg_closed

        if not na(FVG)
            plot_fvg(FVG, bull_fvgs_1, bear_fvgs_1)

        if bull_fvgs_1.size() > 0
            [bull_fvg_m, bull_fvg_c] = update_bullish_fvgs(bull_fvgs_1, htf_close, htf_low)
            bull_fvg_mitigated := bull_fvg_m
            bull_fvg_closed := bull_fvg_c
        else
            bull_fvg_mitigated := false
            bull_fvg_closed := false

        if bear_fvgs_1.size() > 0
            [bear_fvg_m, bear_fvg_c] = update_bearish_fvgs(bear_fvgs_1, htf_close, htf_high)
            bear_fvg_mitigated := bear_fvg_m
            bear_fvg_closed := bear_fvg_c
        else
            bear_fvg_mitigated := false
            bear_fvg_closed := false
            
        new_fvg_mitigated := bull_fvg_mitigated or bear_fvg_mitigated
        new_fvg_closed := bull_fvg_closed or bear_fvg_closed
        
    if display_htf2 and na(duplicate_tf(htf2, selected_tfs))
        selected_tfs.unshift(htf2)

        var array<fvg> bull_fvgs_2 = array.new<fvg>()
        var array<fvg> bear_fvgs_2 = array.new<fvg>()

        [FVG, bull_fvg_o, bear_fvg_o, htf_close, htf_high, htf_low] = request.security(syminfo.tickerid, htf2, detect_fvg())
        
        bull_fvg_opened := bull_fvg_o
        bear_fvg_opened := bear_fvg_o
        new_fvg_opened := bull_fvg_opened or bear_fvg_opened

        if not na(FVG)
            plot_fvg(FVG, bull_fvgs_2, bear_fvgs_2)

        if bull_fvgs_2.size() > 0
            [bull_fvg_m, bull_fvg_c] = update_bullish_fvgs(bull_fvgs_2, htf_close, htf_low)
            bull_fvg_mitigated := bull_fvg_m
            bull_fvg_closed := bull_fvg_c
        else
            bull_fvg_mitigated := false
            bull_fvg_closed := false

        if bear_fvgs_2.size() > 0
            [bear_fvg_m, bear_fvg_c] = update_bearish_fvgs(bear_fvgs_2, htf_close, htf_high)
            bear_fvg_mitigated := bear_fvg_m
            bear_fvg_closed := bear_fvg_c
        else
            bear_fvg_mitigated := false
            bear_fvg_closed := false
            
        new_fvg_mitigated := bull_fvg_mitigated or bear_fvg_mitigated
        new_fvg_closed := bull_fvg_closed or bear_fvg_closed

    if display_htf3 and na(duplicate_tf(htf3, selected_tfs))
        selected_tfs.unshift(htf3)

        var array<fvg> bull_fvgs_3 = array.new<fvg>()
        var array<fvg> bear_fvgs_3 = array.new<fvg>()

        [FVG, bull_fvg_o, bear_fvg_o, htf_close, htf_high, htf_low] = request.security(syminfo.tickerid, htf3, detect_fvg())
        
        bull_fvg_opened := bull_fvg_o
        bear_fvg_opened := bear_fvg_o
        new_fvg_opened := bull_fvg_opened or bear_fvg_opened

        if not na(FVG)
            plot_fvg(FVG, bull_fvgs_3, bear_fvgs_3)

        if bull_fvgs_3.size() > 0
            [bull_fvg_m, bull_fvg_c] = update_bullish_fvgs(bull_fvgs_3, htf_close, htf_low)
            bull_fvg_mitigated := bull_fvg_m
            bull_fvg_closed := bull_fvg_c
        else
